# ============================================
# Personal OS — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================

# ── PUBLIC (exposed to client via import.meta.env) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Personal OS

# ── PRIVATE (server-side only — NOT prefixed with VITE_) ──
# These are used in Supabase Edge Functions or server-side only.
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
